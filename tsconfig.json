{
    "extends": "expo/tsconfig.base",
    "compilerOptions": {
        "strict": true,
        "baseUrl": ".",
        "paths": {
            "@constants/*": ["src/constants/*"],
            "@components/*": ["src/components/*"],
            "@types/*": ["src/types/*"],
            "@utils/*": ["src/utils/*"]
        }
    }
}
